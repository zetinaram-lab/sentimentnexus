# SentimentNexus Environment Variables

# Finnhub API (Free tier: 60 calls/minute)
# Get your free API key at: https://finnhub.io/register
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage API (Free tier: 25 calls/day)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
VITE_ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Metals API (Free tier: 50 calls/month)
# Get your free API key at: https://metals-api.com/
VITE_METALS_API_KEY=your_metals_api_key_here

# OpenAI for Sentiment Analysis (Optional)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Twilio for WhatsApp Alerts (Optional)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
VITE_TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
VITE_YOUR_WHATSAPP_NUMBER=whatsapp:+521234567890

# App Configuration
VITE_API_URL=https://api.sentimentnexus.com
VITE_ENABLE_REAL_API=false
